        "server.conf": "bind 0.0.0.0\nprotected-mode no\nport 6379\nsave \"\"\ndir /data\nmaxmemory 768mb\nmaxmemory-policy noeviction\nauto-aof-rewrite-percentage 0\nno-appendfsync-on-rewrite no\nappendonly no\n"
