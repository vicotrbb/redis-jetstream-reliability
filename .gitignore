# LaTeX intermediates. Keep the two receipts required for offline PDF checks.
/paper/*.aux
/paper/*.bbl
/paper/*.blg
/paper/*.fdb_latexmk
/paper/*.fls
/paper/*.log
/paper/*.out
/paper/*.toc
/paper/*.synctex.gz
!/paper/main.bbl
!/paper/main.log

# The paper PDFs, figures, raw data, execution logs, and validation receipts
# are intentional research artifacts and remain tracked.
